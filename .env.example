# Salin file ini menjadi ".env" untuk development lokal (`vercel dev`).
# Untuk deploy sungguhan, isi variabel-variabel ini di Vercel Dashboard →
# Project Settings → Environment Variables — JANGAN commit file ".env" asli.

# --- Neon (Database) -----------------------------------------------------
# Neon Console -> project kamu -> "Connection Details". Pakai connection
# string yang PAKAI pooling (biasanya sudah default / ada label "pooled"),
# bukan yang "direct connection".
DATABASE_URL=postgres://username:password@ep-xxxxxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Vercel Blob (Storage) -------------------------------------------------
# Dua store terpisah: satu PUBLIC (foto produk), satu PRIVATE (bukti
# transfer). Buat keduanya dari Vercel Dashboard -> Storage -> Create
# Database -> Blob, lalu salin token read-write masing-masing di sini.
PRODUCTS_BLOB_READ_WRITE_TOKEN=
PROOFS_BLOB_READ_WRITE_TOKEN=

# Batas ukuran video produk dalam MB (opsional, default 50, maksimal 500).
# Video diunggah langsung dari browser admin ke Blob, jadi batas ini tidak
# terikat batas ukuran request Vercel.
# PRODUCT_VIDEO_MAX_MB=50

# --- Alamat situs (opsional) ----------------------------------------------
# Kalau diisi, semua tautan yang dibuat server (misal email pesanan) memakai
# alamat ini. Kalau dikosongkan, alamat diambil dari header permintaan —
# aman, tapi bisa salah kalau ada proxy di depannya. Isi alamat tokomu
# sendiri, tanpa garis miring di akhir.
# SITE_ORIGIN=https://namadomainkamu.com

# --- Login admin --------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# Kunci acak untuk menandatangani cookie sesi admin (bukan password login).
# Buat dengan: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Email notifikasi pesanan (Resend) -----------------------------------
# Dapatkan API key dari https://resend.com/api-keys. Pengirim default
# "onboarding@resend.dev" langsung berfungsi tanpa verifikasi domain — untuk
# mengirim dari domain sendiri, verifikasi domainnya di dashboard Resend lalu
# isi RESEND_FROM (opsional).
RESEND_API_KEY=
SELLER_EMAIL=namatoko@gmail.com
# RESEND_FROM=Pecup <no-reply@namadomainkamu.com>